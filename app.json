{
  "expo": {
    "name": "Fresh Food Map",
    "slug": "fresh-food-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freshfoodmap",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.freshfoodmap",
      "adaptiveIcon": {
        "backgroundColor": "#E7F2E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fresh Food Map uses your location on this device to show markets near you and sort them by distance. Nothing is tracked or stored. Addresses you look up are sent to OpenStreetMap to find their coordinates."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "app.freshfoodmap",
      "config": {
        "usesNonExemptEncryption": false
      }
    }
  }
}
