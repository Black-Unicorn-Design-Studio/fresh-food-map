    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-location": "~57.0.5",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "maplibre-gl": "^5.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "tz-lookup": "^6.1.25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios:verify": "bash scripts/verify-ios-link.sh",
    "ios": "npm run ios:verify && expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite --import tsx --test \"test/**/*.test.ts\"",
    "validate-data": "tsx scripts/validate-data.ts",
    "build:web": "cp data/markets.json public/markets.json && expo export -p web",
    "intake": "node --experimental-sqlite --env-file-if-exists=.env --import tsx server/index.ts",
    "intake:batch": "node --experimental-sqlite --env-file-if-exists=.env --import tsx server/batch.ts"
  },
