# Staging configuration for the VPS. Copy, fill in, never commit:
#
#     cp .env.staging.example .env.staging
#     $EDITOR .env.staging
#
# ---------------------------------------------------------------------------------------
# WHERE TO KEEP IT
# ---------------------------------------------------------------------------------------
# `.gitignore` lists `.env.staging` explicitly — the rules above it, `.env` and
# `.env*.local`, match neither this name nor that one, so the line is there on purpose and
# removing it means the next `git add -A` on the VPS stages a GitHub token. Confirm it with
# `git check-ignore -v .env.staging` before you put a secret in the file.
#
# Stronger, and what to prefer on a server: keep it outside the working tree entirely and
# point at it.
#
#     install -d -m 700 /etc/fresh-food-map
#     cp .env.staging.example /etc/fresh-food-map/staging.env && chmod 600 "$_"
#     docker compose --env-file /etc/fresh-food-map/staging.env --profile persistent up -d
#
# Outside the tree, no git command can stage it, no `git clean` can delete it, and a
# `.gitignore` edit cannot expose it. Whichever you choose, use the SAME `--env-file` path
# on every command in this deployment — Compose has no memory of the last one.
#
# `.dockerignore` excludes `.env.*`, so no env file reaches the build context and no layer
# can contain a secret. Nothing here is ever baked into the image.
#
# ---------------------------------------------------------------------------------------
# How this file is read
# ---------------------------------------------------------------------------------------
# Compose only auto-loads a file called `.env`, so every command needs `--env-file`:
#
#     docker compose --env-file .env.staging --profile persistent up -d --build
#
# Forget it and the run aborts with "required variable ... is missing a value" rather than
# starting a stack with an empty salt. Variables reach the containers through explicit
# `environment:` blocks in docker-compose.yml, one per service, so no container receives a
# secret it has no use for — the persistent-mode API container is never given GITHUB_TOKEN.
#
# There is no second source of configuration. The npm scripts pass
# `--env-file-if-exists=.env`, but the image does not run them — its CMD invokes node
# directly with that flag deliberately omitted, and no `.env` exists inside the container
# anyway. What Compose puts in the environment is the whole of it.


# =======================================================================================
# REQUIRED IN BOTH MODES
# =======================================================================================

# The hostname you have pointed at this VPS's public IP. Caddy uses it to request a
# certificate, so the A/AAAA record must already resolve here or the ACME challenge fails
# and nothing gets served over TLS. No scheme, no trailing slash.
#
# Unset, the Caddyfile's site block has no address, the config fails to parse and Caddy
# exits — on purpose. A box serving the wrong name, or no name and therefore no
# certificate, is worse than one that visibly did not start.
SITE_HOST=staging.freshfoodmap.app

# The domain the store builds are compiled against (eas.json), plus www, which the Caddyfile
# derives. Until production exists it answers only what an installed app calls —
# /markets.json and /intake/* — and 308s everything else to SITE_HOST. Same rules as above:
# an A record to this box and no AAAA, set before `up`, no scheme. Its DNS must resolve here
# before the first `up` that carries it, or the certificate order spends the rate limit.
APEX_HOST=freshfoodmap.app

# Salt for hashing IP buckets before they are stored (server/client-ip.ts). Generate one:
#
#     openssl rand -hex 32
#
# Paste the output below. Keep it stable: rotating the salt resets every rate-limit
# counter, because old buckets no longer hash to anything the new ones match.
#
# The service now refuses to start without it — assertServiceEnv() in server/config.ts is
# called before the socket listens, so a missing salt is a container that never goes live
# rather than one that reports healthy and throws on somebody's submission.
INTAKE_IP_SALT=

# Which ACME directory to get certificates from. Optional: blank means the Caddyfile's
# default, the production Let's Encrypt CA, which is what you want once DNS is settled.
#
# While the A record is still propagating, set it to the staging CA:
#
#     ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
#
# Failed validations count against a per-hostname rate limit at the production CA, and
# spending that limit turns "the DNS record is wrong" into an hour of waiting to find out.
# Certificates from the staging CA are not trusted by browsers — expect a warning, and
# clear it by unsetting this and running `docker compose ... up -d --force-recreate caddy`.
ACME_CA=


# =======================================================================================
# EPHEMERAL MODE ONLY (--profile ephemeral, INTAKE_STORE=github)
# =======================================================================================
# In this mode the queue is a JSON file on a branch, so the API container itself commits on
# every accepted submission. GITHUB_TOKEN below is therefore REQUIRED AT BOOT here — the
# store's init() reads the queue branch before the service listens, and a missing token
# fails the container immediately.
#
# In persistent mode this whole section is unused by the API. The token is still needed for
# the batching agent, which is why it lives under "both modes" below rather than here.

# Branch holding the queue file. Cut from GITHUB_BASE_BRANCH automatically if absent — which
# means that branch must already exist on the remote, or boot fails with
# "cannot read staging: 404".
#
# Keep this distinct from whatever a production deployment uses. Sharing one queue branch
# means staging traffic ends up in a real pull request.
INTAKE_QUEUE_BRANCH=intake-queue-staging

# Path to the queue file within that branch. The default is fine.
INTAKE_QUEUE_PATH=intake-queue.json


# =======================================================================================
# BOTH MODES — the batching agent
# =======================================================================================
# The agent is a one-shot you run yourself:
#
#     docker compose --env-file .env.staging run --rm batch             # persistent
#     docker compose --env-file .env.staging run --rm batch-ephemeral   # ephemeral

# Fine-grained personal access token, scoped to the one repository, with:
#
#     Contents: read and write        (commit the dataset, and the queue branch in ephemeral)
#     Pull requests: read and write   (open the pull request)
#
# IT MUST NOT BE ABLE TO MERGE INTO GITHUB_BASE_BRANCH. Contents write is enough to commit
# straight to the base branch, which would publish markets nobody ever reviewed and defeat
# the only gate this pipeline has. Protect `staging` on GitHub — require a pull request,
# and do not add this token to any bypass list. The protection is what makes the permission
# safe; the permission alone is not.
#
# Never prefix a credential with EXPO_PUBLIC_. That prefix is inlined into the web bundle
# and is public by construction.
GITHUB_TOKEN=

# owner/repo. Staging pull requests go to the same repository as production, on a different
# base branch.
GITHUB_REPO=Black-Unicorn-Design-Studio/fresh-food-map

# What pull requests target and what the queue branch is cut from. `staging`, never `main`:
# a merge on staging must not publish to the live dataset.
GITHUB_BASE_BRANCH=staging


# =======================================================================================
# NOT READ BY COMPOSE — needed when you build the web export
# =======================================================================================
# Anything EXPO_PUBLIC_* is inlined into the JavaScript bundle at build time. Setting it in
# this file changes nothing at runtime: Caddy serves already-built files out of ./dist, so
# these must be in the environment of the build itself, on the VPS, before `up`:
#
#     EXPO_PUBLIC_INTAKE_URL=https://staging.freshfoodmap.app/intake \
#     EXPO_PUBLIC_SOURCE_URL=https://github.com/Black-Unicorn-Design-Studio/fresh-food-map \
#     EXPO_PUBLIC_DATA_URL=https://staging.freshfoodmap.app/markets.json \
#       npm run build:web
#
# EXPO_PUBLIC_INTAKE_URL — the `/intake` suffix and nothing more: src/lib/submit.ts appends
# `/submit` itself, and Caddy's `handle_path /intake/*` strips the prefix before proxying, so
# the service receives the `/submit` it matches on exactly. Any other shape 404s. Leave it
# unset and the Submit tab explains how to open a pull request instead — which is a valid
# build, just not the one this deployment exists to test.
#
# EXPO_PUBLIC_SOURCE_URL — AGPL §6(d): directions to the Corresponding Source travel with
# the object code, and a browser that loaded this build has received a copy. A fork must
# point this at its own repository.
#
# EXPO_PUBLIC_DATA_URL — optional, and only interesting here because the same Caddy serves
# it. `build:web` copies data/markets.json to public/, so the export lands at /markets.json
# and the app can refetch the dataset without a rebuild (src/lib/markets.ts). Unset means
# bundled-only, which is the normal state and needs nothing running.
#
# Use `npm run build:web`, not bare `expo export` — it does that copy, and skipping it ships
# a stale dataset under a URL that looks fresh.
#
# Rebuild whenever the hostname changes. These are compiled in; restarting Caddy will not
# pick up a new one, and neither will editing this file.


# =======================================================================================
# DELIBERATELY NOT HERE — set by docker-compose.yml, not by you
# =======================================================================================
# The service reads four more variables. All four are fixed by the compose file, per
# service, because getting them wrong is how this deployment breaks quietly. Setting them in
# this file does nothing: the `environment:` blocks win.
#
#   INTAKE_STORE                  the profile IS this setting — `sqlite` on the persistent
#                                 service, `github` on the ephemeral one. Choosing it here
#                                 instead would let the profile and the store disagree.
#   INTAKE_DB_PATH                /data/intake.db, on the `intake-data` volume. Left at its
#                                 default the queue would sit on the container's writable
#                                 layer and be discarded on every rebuild, silently.
#   INTAKE_TRUSTED_PROXY_HEADER   X-Forwarded-For. Behind Caddy the socket address is
#                                 Caddy's, so unset means the whole internet shares one
#                                 rate-limit bucket — five submissions an hour, total.
#   PORT                          8787, never published to the host. Caddy is the only
#                                 route in, which is what makes trusting the header above
#                                 safe rather than a hole.
