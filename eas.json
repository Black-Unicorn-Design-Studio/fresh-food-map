{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_DATA_URL": "https://freshfoodmap.app/markets.json",
        "EXPO_PUBLIC_INTAKE_URL": "https://freshfoodmap.app/intake",
        "EXPO_PUBLIC_SOURCE_URL": "https://github.com/Black-Unicorn-Design-Studio/fresh-food-map"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6825030388"
      }
    }
  }
}
