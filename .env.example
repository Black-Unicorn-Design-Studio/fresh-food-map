# Copy to .env and fill in what your deployment needs. v1 needs none of this to
# run the app — discovery works off the bundled dataset with no configuration at
# all. These only matter if you are also running the submission intake service.


# Where THIS build's source code lives. AGPL-3.0 §6(d) requires directions to the
# Corresponding Source to travel with the object code, and a browser loading the web
# build has received a copy — so the app links to it from the list screen.
# A fork MUST set this to its own repository: linking upstream would point people at
# code that is not what you shipped.
EXPO_PUBLIC_SOURCE_URL=https://github.com/Black-Unicorn-Design-Studio/fresh-food-map

# Where the submission intake service is reachable (server/README.md). Unset means
# the Submit tab explains how to open a pull request instead, which is always valid.
EXPO_PUBLIC_INTAKE_URL=http://127.0.0.1:8787
